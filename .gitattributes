# Исходники держим в LF, чтобы Windows-машины не плодили diff'ы на переводах строк.
* text=auto eol=lf

*.rb     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.csv    text eol=lf
*.md     text eol=lf
*.erb    text eol=lf
Gemfile  text eol=lf
Gemfile.lock text eol=lf
Rakefile text eol=lf
bin/*    text eol=lf

*.jpg binary
*.png binary
*.docx binary

