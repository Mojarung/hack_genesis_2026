# frozen_string_literal: true

# Сгенерировано paygen <%= paygen_version %>.

require "faraday"
require "faraday/retry"
require "json"
require "securerandom"

require_relative "version"

module <%= module_name %>
  class Client
    DEFAULT_BASE_URL = "<%= api.base_url %>"
    USER_AGENT = "<%= gem_name %>-ruby/#{VERSION}"
    RETRY_STATUSES = [429, 500, 502, 503, 504].freeze

    attr_reader :connection, :base_url
<% case api.auth.kind
   when :basic -%>

    # Аутентификация: HTTP Basic.
    def initialize(username:, password:, base_url: DEFAULT_BASE_URL, **options)
      @username = username
      @password = password
<% when :none -%>

    # Спецификация не объявляет securitySchemes — клиент ходит без авторизации.
    def initialize(base_url: DEFAULT_BASE_URL, **options)
<% else -%>

    # Аутентификация: <%= api.auth.kind %> (<%= api.auth.name %> в <%= api.auth.location %>).
    def initialize(api_key:, base_url: DEFAULT_BASE_URL, **options)
      raise ArgumentError, "api_key обязателен" if api_key.nil? || api_key.to_s.empty?

      @api_key = api_key
<% end -%>
      @base_url = base_url.to_s.sub(%r{/+\z}, "")
      @timeout = options.fetch(:timeout, 15)
      @open_timeout = options.fetch(:open_timeout, 5)
      @retries = options.fetch(:retries, 2)
      @logger = options[:logger]
      @connection = build_connection(options[:adapter])
    end
<% api.resources.each do |resource| -%>

<%= doc_comment(resource.description, indent: 4).join("\n") %>
    def <%= resource.method_name %>
      @<%= resource.method_name %> ||= Resources::<%= resource.class_name %>.new(self)
    end
<% end -%>

    # Единая точка выхода: сюда сходятся все методы ресурсов.
    # @return [Hash, Array, String, nil] разобранное тело ответа
    def request(method, path, query: nil, body: nil, headers: {})
      # Ведущий слеш в Faraday затирает путь базового URL (/v1), поэтому режем его.
      response = connection.public_send(method, path.delete_prefix("/")) do |req|
        req.params.update(query.compact) if query.respond_to?(:compact) && !query.empty?
        req.headers.update(default_headers(method)).update(headers.compact)
        req.body = JSON.generate(body) unless body.nil?
      end
      handle(response)
    rescue Faraday::TimeoutError, Faraday::ConnectionFailed => e
      raise ConnectionError, e.message
    end

    private

    def handle(response)
      payload = parse_body(response)
      return payload if response.success?

      raise ApiError.from_response(response.status, payload, request_id: response.headers["x-request-id"])
    end

    def parse_body(response)
      body = response.body
      return nil if body.nil? || body.empty?

      JSON.parse(body)
    rescue JSON::ParserError
      body
    end

    def default_headers(method)
      headers = {
        "Accept" => "application/json",
        "Content-Type" => "application/json",
        "User-Agent" => USER_AGENT
      }
      # Небезопасные методы без ключа идемпотентности при ретрае = двойное списание.
      headers["Idempotency-Key"] = SecureRandom.uuid if %i[post patch].include?(method)
      headers.merge(auth_headers)
    end

    def auth_headers
<% case api.auth.kind
   when :bearer, :oauth2 -%>
      { "Authorization" => "Bearer #{@api_key}" }
<% when :api_key -%>
<% if api.auth.location == :header -%>
      { "<%= api.auth.name %>" => @api_key }
<% else -%>
      {} # ключ уезжает в query, см. build_connection
<% end -%>
<% else -%>
      {}
<% end -%>
    end

    def build_connection(adapter)
      # Слеш на конце обязателен: иначе относительный путь съест последний сегмент базы.
      Faraday.new(url: "#{base_url}/") do |f|
<% if api.auth.kind == :basic -%>
        f.request :authorization, :basic, @username, @password
<% elsif api.auth.kind == :api_key && api.auth.location != :header -%>
        f.params["<%= api.auth.name %>"] = @api_key
<% end -%>
        # POST не ретраим автоматически: он идемпотентен только вместе с Idempotency-Key,
        # который провайдер может и не поддерживать.
        f.request :retry, max: @retries, interval: 0.2, backoff_factor: 2,
                          retry_statuses: RETRY_STATUSES,
                          methods: %i[get put delete head options]
        f.response :logger, @logger if @logger
        f.options.timeout = @timeout
        f.options.open_timeout = @open_timeout
        f.adapter(adapter || Faraday.default_adapter)
      end
    end
  end
end
