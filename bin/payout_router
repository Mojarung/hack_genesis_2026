#!/usr/bin/env ruby
# frozen_string_literal: true

# bundler/setup подключает гемы из vendor/bundle, чтобы работало и `ruby -Ilib bin/payout_router ...`,
# а не только `bundle exec ...`.
require "bundler/setup"

# YJIT ускоряет горячий путь (скоринг гоняет одни и те же методы на каждой заявке) и ничего не меняет
# в результате. Есть не в каждой сборке: официальный ruby:4.0 на Linux — да, RubyInstaller под Windows
# собран без него. Поэтому включаем по факту наличия, а не по версии.
RubyVM::YJIT.enable if defined?(RubyVM::YJIT) && !RubyVM::YJIT.enabled?

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "payout_router"

PayoutRouter::CLI.start(ARGV)
